# Salin ke `.env` lalu isi nilainya. JANGAN commit `.env`.

# Base URL backend (opsional; default http://localhost:8005/api)
VITE_API_URL=http://localhost:8005/api

# OAuth 2.0 Web Client ID dari Google Cloud Console.
# Authorized JavaScript origins: http://localhost:8006
# Tanpa ini, tombol "Masuk dengan Google" disembunyikan.
VITE_GOOGLE_CLIENT_ID=
